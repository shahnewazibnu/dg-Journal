{
  "name": "Digital Journal",
  "short_name": "Journal",
  "description": "A private photo journal with a calendar and month and year recaps.",
  "start_url": "./index.html#/journal",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ECEEEA",
